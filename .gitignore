# Secrets
.env
.env.*

# OS / editor
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Corpora: raw and derived stay local; human consensus labels in data/manual/
# are tracked because SFT, GRPO and evaluation on MLeRP have no other source.
/data/proprietary/
*.csv
*.jsonl
!data/manual/
!data/manual/*.csv

# Model weights and trainer state: regenerable, and individually large enough
# that GitHub rejects them (a Qwen-7B optimizer.pt is ~320MB against a 100MB
# limit). Ignored by PATTERN, not by directory, so small provenance files such
# as train_metadata.json can still be tracked alongside the checkpoint.
/models/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
**/local_finetuned_model/
**/checkpoint-*/

# Experiment outputs (regenerable). The exceptions are sub-kilobyte summaries
# that are the only durable record of a run: comparison.csv is the
# machine-readable form of docs/BASELINE_RESULTS.md, and the GRPO JSONs each
# cost an hour or more of A100 time to reproduce. The per-row probe CSVs and
# every model artifact stay out.
outputs/*
!outputs/baseline_eval/
outputs/baseline_eval/*
!outputs/baseline_eval/comparison.csv
!outputs/grpo/
outputs/grpo/*
!outputs/grpo/faithfulness_*.json
!outputs/grpo/calibration_*.json
